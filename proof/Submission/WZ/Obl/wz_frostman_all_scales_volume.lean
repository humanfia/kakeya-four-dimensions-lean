al ((((Set.ncard {i : Fin n | Metric.thickening δ (segment ℝ (x i) (x i + v i)) ⊆ Metric.thickening ρ (segment ℝ (z j) (z j + w j)) ∧ Metric.thickening δ (segment ℝ (x i) (x i + v i)) ⊆ W} : ℕ) : ℝ)) * ρ ^ 2) ≤ ENNReal.ofReal ((δ ^ (-η)) * (((Set.ncard {i : Fin n | Metric.thickening δ (segment ℝ (x i) (x i + v i)) ⊆ Metric.thickening ρ (segment ℝ (z j) (z j + w j))} : ℕ) : ℝ))) * MeasureTheory.volume W)) → ENNReal.ofReal (a * δ ^ ε) ≤ MeasureTheory.volume (⋃ i : Fin n, Y i) := by
