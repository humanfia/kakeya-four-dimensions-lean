/-- A readable return rule containing just the assumptions used by Scalar
and physical return. The frozen atlas hypotheses are passed through the model. -/
def ReturnRule : Prop :=
  ∀ (α : Type) [MeasurableSpace α] (m : Model α),
    (∀ k, 2 ≤ m.N k) → Tendsto m.N atTop atTop →
    ((∀ k, 1 ≤ m.K k) ∧ ∀ ε : ℝ, 0 < ε → ∀ᶠ k in atTop, m.K k ≤ m.N k ^ ε) →
    0 ≤ m.d → m.d < 1 → 0 < m.κ → m.κ ≤ 1 → m.Basic → m.Caps →
    ∀ (M s₀ : ℝ) (depth : Fin 3 → ℝ), 0 < s₀ → 100 * s₀ < M →
      (∀ h, s₀ < depth h ∧ depth h < 3 * s₀ / 2) → ChartsReady m M s₀ depth →
      ∃ R : ℝ, 1 < R ∧ ∀ ε : ℝ, 0 < ε → ∀ᶠ k in atTop, ProjectedAt m k M s₀ R ε depth

