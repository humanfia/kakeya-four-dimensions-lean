import Submission.Obl.k4_extremal_profile_setup.ScalarBridge

namespace Submission.Obl.k4_extremal_profile_setup

set_option linter.unusedVariables false

noncomputable def TerminalExpanded : (ℕ → ℝ) → (ℕ → ℝ) → ℝ → (W : ℕ → ℕ) → ((k : ℕ) → Fin (W k) → ℝ) → ((k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ))) → ((k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) → ((k : ℕ) → Fin (W k) → ℝ) → (ℝ → ℝ) → ℝ → Prop :=
  (fun N K L W ω ν E B f h => ∃ M D : ℕ, ∀ ε : ℝ, 0 < ε → ∃ᶠ k in Filter.atTop, ∃ κ : ℝ, 1 ≤ κ ∧ K k ≤ κ ∧ κ ≤ N k ^ ε ∧ ∃ T C' : ℕ, ∃ (γ : Fin (C') → Fin (W k)) (j : Fin (C') → Fin (2 ^ T)) (c u : Fin (C') → EuclideanSpace ℝ (Fin 2)) (Q : Fin (C') → Matrix (Fin 2) (Fin 2) ℝ) (R : Fin (C') → MvPolynomial (Fin 4) ℝ) (A : Fin (C') → Set (ℕ × (Fin 6 → ℝ))) (F : Fin (C') → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)), (2 : ℝ) ^ T ≤ N k ^ h ∧ (C' : ℝ) ≤ N k ^ M ∧ (∀ b b', b ≠ b' → γ b = γ b' → j b = j b' → Disjoint (A b) (A b')) ∧ (∀ b, Chart (N k) M D κ T ((j b : ℕ) : ℝ) L (B k (γ b)) (E k (γ b)) (c b) (u b) (Q b) (R b) (A b) (F b) (ENNReal.ofReal (N k ^ (-f L) * |Matrix.det (Q b)| / ((2 : ℝ) ^ T * κ)) ≤ (((ν k (γ b)).prod MeasureTheory.volume) (F b)))) ∧ ENNReal.ofReal ((κ)⁻¹) ≤ ∑ b, ENNReal.ofReal (ω k (γ b)) * (((ν k (γ b)).prod MeasureTheory.volume) (F b)))

noncomputable def HorizonExpanded : (ℕ → ℝ) → (ℕ → ℝ) → ℝ → (W : ℕ → ℕ) → ((k : ℕ) → Fin (W k) → ℝ) → ((k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ))) → ((k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) → ((k : ℕ) → Fin (W k) → ℝ) → (ℝ → ℝ) → ℝ :=
  (fun N K L W ω ν E B f => sInf {h : ℝ | TerminalExpanded N K L W ω ν E B f h})

noncomputable def KnownExpanded : (ℕ → ℝ) → (ℕ → ℝ) → ℝ → (W : ℕ → ℕ) → ((k : ℕ) → Fin (W k) → ℝ) → ((k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ))) → ((k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) → ((k : ℕ) → Fin (W k) → ℝ) → (ℝ → ℝ) → ℝ → ℝ → Prop :=
  (fun N K L W ω ν E B f r h => ∃ M D : ℕ, ∀ ε : ℝ, 0 < ε → ∃ᶠ k in Filter.atTop, ∃ κ : ℝ, 1 ≤ κ ∧ κ ≤ N k ^ ε ∧ ∃ T C' : ℕ, ∃ (γ : Fin C' → Fin (W k)) (j : Fin C' → Fin (2 ^ T)) (c u : Fin C' → EuclideanSpace ℝ (Fin 2)) (Q : Fin C' → Matrix (Fin 2) (Fin 2) ℝ) (R : Fin C' → MvPolynomial (Fin 4) ℝ) (A : Fin C' → Set (ℕ × (Fin 6 → ℝ))) (F : Fin C' → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) (lst : Fin (W k) → (EuclideanSpace ℝ (Fin 3) × ℤ) → Finset (Fin C')), (2 : ℝ) ^ T ≤ N k ^ (h + ε) ∧ (C' : ℝ) ≤ N k ^ M ∧ (∀ b b', b ≠ b' → γ b = γ b' → j b = j b' → Disjoint (A b) (A b')) ∧ (∀ γ₁ o, ((lst γ₁ o).card : ℝ) ≤ κ) ∧ (∀ b, Chart (N k) M D κ T ((j b : ℕ) : ℝ) r (B k (γ b)) (E k (γ b)) (c b) (u b) (Q b) (R b) (A b) (F b) (∀ p ∈ F b, b ∈ lst (γ b) (obs (B k (γ b)) (δ (N k) L) p))) ∧ ENNReal.ofReal κ⁻¹ ≤ ∑ b, ENNReal.ofReal (ω k (γ b)) * ((ν k (γ b)).prod MeasureTheory.volume) (F b))

noncomputable def ExactTimeExpanded : (ℕ → ℝ) → (ℕ → ℝ) → ℝ → (W : ℕ → ℕ) → ((k : ℕ) → Fin (W k) → ℝ) → ((k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ))) → ((k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) → ((k : ℕ) → Fin (W k) → ℝ) → (ℝ → ℝ) → ℝ → Prop :=
  (fun N K L W ω ν E B f h => (∃ M D : ℕ, ∀ ε : ℝ, 0 < ε → ∃ᶠ k in Filter.atTop, ∃ κ : ℝ, 1 ≤ κ ∧ κ ≤ N k ^ ε ∧ ∃ T C' : ℕ, ∃ (γ : Fin C' → Fin (W k)) (j : Fin C' → Fin (2 ^ T)) (c u : Fin C' → EuclideanSpace ℝ (Fin 2)) (Q : Fin C' → Matrix (Fin 2) (Fin 2) ℝ) (R : Fin C' → MvPolynomial (Fin 4) ℝ) (A : Fin C' → Set (ℕ × (Fin 6 → ℝ))) (F : Fin C' → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)), N k ^ (h - ε) ≤ (2 : ℝ) ^ T ∧ (2 : ℝ) ^ T ≤ N k ^ (h + ε) ∧ (C' : ℝ) ≤ N k ^ M ∧ (∀ b b', b ≠ b' → γ b = γ b' → j b = j b' → Disjoint (A b) (A b')) ∧ (∀ b, Chart (N k) M D κ T ((j b : ℕ) : ℝ) L (B k (γ b)) (E k (γ b)) (c b) (u b) (Q b) (R b) (A b) (F b) (ENNReal.ofReal (N k ^ (-f L) * |Matrix.det (Q b)| / ((2 : ℝ) ^ T * κ)) ≤ ((ν k (γ b)).prod MeasureTheory.volume) (F b))) ∧ ENNReal.ofReal κ⁻¹ ≤ ∑ b, ENNReal.ofReal (ω k (γ b)) * ((ν k (γ b)).prod MeasureTheory.volume) (F b)))

noncomputable def InitialHorizonExpanded : Prop :=
  (∀ N K L d S η W ω ν E P B f g G, Problem N K L d S η W ω ν E P B f g G → ∀ h : ℝ, L < h → TerminalExpanded N K L W ω ν E B f h)

noncomputable def TerminalExtensionExpanded : Prop :=
  (∀ (d₀ S η : ℝ), d₀ < 1 → 0 < S → 0 < η → ∃ Cx cx : ℝ, 0 < Cx ∧ 0 < cx ∧ ∀ N K L d W ω ν E P B f g G, Problem N K L d S η W ω ν E P B f g G → d ≤ d₀ → ∀ h e : ℝ, 0 < e → e < h → e < cx * L → (∃ M D : ℕ, ∀ ε : ℝ, 0 < ε → ∃ᶠ k in Filter.atTop, ∃ κ : ℝ, 1 ≤ κ ∧ κ ≤ N k ^ ε ∧ ∃ T C' : ℕ, ∃ (γ : Fin C' → Fin (W k)) (j : Fin C' → Fin (2 ^ T)) (c u : Fin C' → EuclideanSpace ℝ (Fin 2)) (Q : Fin C' → Matrix (Fin 2) (Fin 2) ℝ) (R : Fin C' → MvPolynomial (Fin 4) ℝ) (A : Fin C' → Set (ℕ × (Fin 6 → ℝ))) (F : Fin C' → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)), N k ^ (h - ε) ≤ (2 : ℝ) ^ T ∧ (2 : ℝ) ^ T ≤ N k ^ (h + ε) ∧ (C' : ℝ) ≤ N k ^ M ∧ (∀ b b', b ≠ b' → γ b = γ b' → j b = j b' → Disjoint (A b) (A b')) ∧ (∀ b, Chart (N k) M D κ T ((j b : ℕ) : ℝ) L (B k (γ b)) (E k (γ b)) (c b) (u b) (Q b) (R b) (A b) (F b) (ENNReal.ofReal (N k ^ (-f L) * |Matrix.det (Q b)| / ((2 : ℝ) ^ T * κ)) ≤ ((ν k (γ b)).prod MeasureTheory.volume) (F b))) ∧ ENNReal.ofReal κ⁻¹ ≤ ∑ b, ENNReal.ofReal (ω k (γ b)) * ((ν k (γ b)).prod MeasureTheory.volume) (F b)) → ∃ L₁ : ℝ, 0 < L₁ ∧ L₁ < L ∧ L - L₁ ≤ Cx * e ∧ ∃ M D : ℕ, ∀ ε : ℝ, 0 < ε → ∃ᶠ k in Filter.atTop, ∃ κ : ℝ, 1 ≤ κ ∧ κ ≤ N k ^ ε ∧ ∃ T C' : ℕ, ∃ (γ : Fin C' → Fin (W k)) (j : Fin C' → Fin (2 ^ T)) (c u : Fin C' → EuclideanSpace ℝ (Fin 2)) (Q : Fin C' → Matrix (Fin 2) (Fin 2) ℝ) (R : Fin C' → MvPolynomial (Fin 4) ℝ) (A : Fin C' → Set (ℕ × (Fin 6 → ℝ))) (F : Fin C' → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) (lst : Fin (W k) → (EuclideanSpace ℝ (Fin 3) × ℤ) → Finset (Fin C')), (2 : ℝ) ^ T ≤ N k ^ (h - e + ε) ∧ (C' : ℝ) ≤ N k ^ M ∧ (∀ b b', b ≠ b' → γ b = γ b' → j b = j b' → Disjoint (A b) (A b')) ∧ (∀ γ₁ o, ((lst γ₁ o).card : ℝ) ≤ κ) ∧ (∀ b, Chart (N k) M D κ T ((j b : ℕ) : ℝ) L₁ (B k (γ b)) (E k (γ b)) (c b) (u b) (Q b) (R b) (A b) (F b) (∀ p ∈ F b, b ∈ lst (γ b) (obs (B k (γ b)) (δ (N k) L) p))) ∧ ENNReal.ofReal κ⁻¹ ≤ ∑ b, ENNReal.ofReal (ω k (γ b)) * ((ν k (γ b)).prod MeasureTheory.volume) (F b))

noncomputable def ExtremalSetupExpanded : ℝ → ℝ → ℝ → ℝ → Prop :=
  (fun ds kr S η => 0 ≤ ds ∧ ds < 1 ∧ 0 < kr ∧ kr ≤ 1 ∧ (∀ t : ℝ, 0 < t → ∃ N K d W ω ν E P B f g G, Problem N K 1 d S η W ω ν E P B f g G ∧ d < ds + t ∧ kr - t < HorizonExpanded N K 1 W ω ν E B f) ∧ (∀ t : ℝ, 0 < t → ∃ a : ℝ, 0 < a ∧ ∀ N K L d W ω ν E P B f g G, Problem N K L d S η W ω ν E P B f g G → d < ds + a → HorizonExpanded N K L W ω ν E B f ≤ (kr + t) * L) ∧ (∀ t : ℝ, 0 < t → ∃ a : ℝ, 0 < a ∧ ∀ N K L d W ω ν E P B f g G, Problem N K L d S η W ω ν E P B f g G → d < ds + a → (kr - a) * L < HorizonExpanded N K L W ω ν E B f → ∀ r : ℝ, 0 ≤ r → r ≤ L → |f r - f 0 - ds * r| ≤ t * L))

noncomputable def RemainderTransferExpanded : Prop :=
  ∀ N K L d S η W ω ν E P B f g G, Problem N K L d S η W ω ν E P B f g G → ∀ r h q : ℝ, 0 ≤ r → r < L → 0 < q → q < 1 → (∀ s : ℝ, r ≤ s → s ≤ L → f L - f s ≤ q * (L - s)) → KnownExpanded N K L W ω ν E B f r h → ∃ N₂ K₂ W₂ ω₂ ν₂ E₂ P₂ B₂ f₂ g₂ G₂, Problem N₂ K₂ (L - r) q S η W₂ ω₂ ν₂ E₂ P₂ B₂ f₂ g₂ G₂ ∧ HorizonExpanded N K L W ω ν E B f ≤ h + HorizonExpanded N₂ K₂ (L - r) W₂ ω₂ ν₂ E₂ B₂ f₂

noncomputable def CoarseningCompositionExpanded : Prop :=
  ∀ N K L d S η W ω ν E P B f g G, Problem N K L d S η W ω ν E P B f g G → ∀ r q U : ℝ, 0 < r → r ≤ L → 0 < q → q < 1 → (∀ s : ℝ, 0 ≤ s → s ≤ r → f r - f s ≤ q * (r - s)) → 0 ≤ U → (∀ N₂ K₂ L₂ d₂ W₂ ω₂ ν₂ E₂ P₂ B₂ f₂ g₂ G₂, Problem N₂ K₂ L₂ d₂ S η W₂ ω₂ ν₂ E₂ P₂ B₂ f₂ g₂ G₂ → d₂ ≤ d → HorizonExpanded N₂ K₂ L₂ W₂ ω₂ ν₂ E₂ B₂ f₂ ≤ U * L₂) → ∃ g₂ G₂, Problem N K r q S η W ω ν E P B f g₂ G₂ ∧ HorizonExpanded N K L W ω ν E B f ≤ HorizonExpanded N K r W ω ν E B f + U * (L - r)

end Submission.Obl.k4_extremal_profile_setup
