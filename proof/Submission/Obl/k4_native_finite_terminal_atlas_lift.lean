  have ht : SampleTransfer p q φ h w := rem.sampleTransfer hp hr hrL
  simpa only [SampleTransfer, terminalAt_iff_expanded,
    narrowTerminalAt_iff_expanded, p, q, Chart, fmt, y, x, δ] using ht
