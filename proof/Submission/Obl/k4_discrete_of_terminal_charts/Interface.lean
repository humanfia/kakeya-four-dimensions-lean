/-- The conclusion of the terminal-chart assertion at time exponent `h`. -/
def TCAConcl (N K : ℕ → ℝ) (L : ℝ) (W : ℕ → ℕ) (ω : (k : ℕ) → Fin (W k) → ℝ) (ν : (k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ))) (E : (k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) (B : (k : ℕ) → Fin (W k) → ℝ) (f : ℝ → ℝ) (h : ℝ) : Prop :=
  ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∃ M D : ℕ, ∃ K' : ℕ → ℝ, ((∀ k, 1 ≤ K' k) ∧ ∀ ε : ℝ, 0 < ε → ∀ᶠ k in Filter.atTop, K' k ≤ N (ψ k) ^ ε) ∧ (∀ k, K (ψ k) ≤ K' k) ∧ ∃ T C' : ℕ → ℕ, ∃ (γ : (k : ℕ) → Fin (C' k) → Fin (W (ψ k))) (j : (k : ℕ) → Fin (C' k) → Fin (2 ^ T k)) (c u : (k : ℕ) → Fin (C' k) → EuclideanSpace ℝ (Fin 2)) (Q : (k : ℕ) → Fin (C' k) → Matrix (Fin 2) (Fin 2) ℝ) (R : (k : ℕ) → Fin (C' k) → MvPolynomial (Fin 4) ℝ) (A : (k : ℕ) → Fin (C' k) → Set (ℕ × (Fin 6 → ℝ))) (F : (k : ℕ) → Fin (C' k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)), ∀ k, (2 : ℝ) ^ T k ≤ N (ψ k) ^ h ∧ (C' k : ℝ) ≤ N (ψ k) ^ M ∧ (∀ b b', b ≠ b' → γ k b = γ k b' → j k b = j k b' → Disjoint (A k b) (A k b')) ∧ (∀ b, Matrix.det (Q k b) ≠ 0 ∧ ‖c k b‖ + ‖u k b‖ ≤ N (ψ k) ^ M ∧ (∑ e : Fin 2, ∑ e' : Fin 2, (|Q k b e e'| + |(Q k b)⁻¹ e e'|)) ≤ N (ψ k) ^ M ∧ (∑ e : Fin 2, ∑ e' : Fin 2, |Q k b e e'|) ≤ K' k / (2 : ℝ) ^ T k ∧ (R k b).totalDegree ≤ 2 ∧ (∀ e, |(R k b).coeff e| ≤ N (ψ k) ^ M) ∧ MeasurableSet (A k b) ∧ MeasurableSet (F k b) ∧ (∀ i, (∃ m₀ : ℕ, (m₀ : ℝ) ≤ (N (ψ k) ^ M) ∧ ∃ p₀ : Fin m₀ → MvPolynomial (Fin 6) ℝ, (∀ i₀, (p₀ i₀).totalDegree ≤ D) ∧ ∃ b₀ : (Fin m₀ → Bool) → Bool, ∀ x₀, x₀ ∈ {x | (i, x) ∈ A k b} ↔ b₀ (fun i₀ => decide (0 ≤ MvPolynomial.eval x₀ (p₀ i₀))) = true) ∧ (∃ m₀ : ℕ, (m₀ : ℝ) ≤ (N (ψ k) ^ M) ∧ ∃ p₀ : Fin m₀ → MvPolynomial (Fin 7) ℝ, (∀ i₀, (p₀ i₀).totalDegree ≤ D) ∧ ∃ b₀ : (Fin m₀ → Bool) → Bool, ∀ x₀, x₀ ∈ ({x₁ : Fin 7 → ℝ | ((i, fun j₁ : Fin 6 => x₁ j₁.castSucc), x₁ 6) ∈ (F k b)}) ↔ b₀ (fun i₀ => decide (0 ≤ MvPolynomial.eval x₀ (p₀ i₀))) = true)) ∧ (∀ l ∈ A k b, (l.1 : ℝ) ≤ N (ψ k) ^ M ∧ (∀ e, |l.2 e| ≤ N (ψ k) ^ M) ∧ ∀ t ∈ (Set.Icc (((j k b : ℕ) : ℝ) / (2 : ℝ) ^ T k) ((((j k b : ℕ) : ℝ) + 1) / (2 : ℝ) ^ T k)), ‖Matrix.toEuclideanLin ((Q k b)⁻¹) ((WithLp.toLp 2 ![![t, l.2 0 + t * l.2 3, l.2 1 + t * l.2 4, l.2 2 + t * l.2 5] 1, ![t, l.2 0 + t * l.2 3, l.2 1 + t * l.2 4, l.2 2 + t * l.2 5] 2]) - c k b - t • u k b)‖ ≤ K' k ∧ |MvPolynomial.eval (![t, l.2 0 + t * l.2 3, l.2 1 + t * l.2 4, l.2 2 + t * l.2 5]) (R k b)| ≤ K' k * ((2 : ℝ) ^ (-(⌊L * Real.log (N (ψ k)) / Real.log 2⌋ : ℤ))) ∧ |MvPolynomial.eval (![t, l.2 0 + t * l.2 3, l.2 1 + t * l.2 4, l.2 2 + t * l.2 5]) (MvPolynomial.pderiv (3 : Fin 4) (R k b))| ≤ K' k * B (ψ k) (γ k b) ∧ |MvPolynomial.eval (![t, l.2 0 + t * l.2 3, l.2 1 + t * l.2 4, l.2 2 + t * l.2 5]) (MvPolynomial.pderiv (3 : Fin 4) (MvPolynomial.pderiv (3 : Fin 4) (R k b)))| ≤ K' k * (B (ψ k) (γ k b)) ^ 2 / ((2 : ℝ) ^ (-(⌊L * Real.log (N (ψ k)) / Real.log 2⌋ : ℤ)))) ∧ (∀ p ∈ F k b, p ∈ E (ψ k) (γ k b) ∧ p.1 ∈ A k b ∧ p.2 ∈ (Set.Icc (((j k b : ℕ) : ℝ) / (2 : ℝ) ^ T k) ((((j k b : ℕ) : ℝ) + 1) / (2 : ℝ) ^ T k)) ∧ B (ψ k) (γ k b) / K' k ≤ |MvPolynomial.eval (![p.2, p.1.2 0 + p.2 * p.1.2 3, p.1.2 1 + p.2 * p.1.2 4, p.1.2 2 + p.2 * p.1.2 5]) (MvPolynomial.pderiv (3 : Fin 4) (R k b))|) ∧ ENNReal.ofReal (N (ψ k) ^ (-f L) * |Matrix.det (Q k b)| / ((2 : ℝ) ^ T k * K' k)) ≤ (((ν (ψ k) (γ k b)).prod MeasureTheory.volume) (F k b))) ∧ ENNReal.ofReal ((K' k)⁻¹) ≤ ∑ b, ENNReal.ofReal (ω (ψ k) (γ k b)) * (((ν (ψ k) (γ k b)).prod MeasureTheory.volume) (F k b))

theorem tca_apply (H3 : TerminalChartAssertion) {N K : ℕ → ℝ} {L d S η : ℝ} {W : ℕ → ℕ}
    {ω : (k : ℕ) → Fin (W k) → ℝ} {ν : (k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ))}
    {E : (k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)} {P : (k : ℕ) → Fin (W k) → MvPolynomial (Fin 4) ℝ}
    {B : (k : ℕ) → Fin (W k) → ℝ} {f : ℝ → ℝ}
    {g : (k : ℕ) → Fin (W k) → ℝ → (EuclideanSpace ℝ (Fin 3) × ℤ) → ENNReal}
    {G : (k : ℕ) → Fin (W k) → ℝ → ((EuclideanSpace ℝ (Fin 3) × ℤ) × (Fin 2 → ℤ)) → ENNReal}
    (hyp : TCAHyp N K L d S η W ω ν E P B f g G) (h : ℝ) (hh : 0 < h) :
    TCAConcl N K L W ω ν E B f h :=
  H3 N K hyp.two_le_N hyp.tendsto_N hyp.subpower_K L d S η hyp.L_pos hyp.d_pos hyp.d_lt_one
    hyp.S_pos hyp.η_pos W ω ν E P B f g G hyp.tempered hyp.pureDensity hyp.angularDensity
    hyp.profile hyp.pureHomogeneous hyp.endpointCap hyp.angularCap h hh

/-- The interface between the construction and the comparison: the native scale is `1`, and
the slope marginal of every prior has density at most `Λ k`, which is smaller than the terminal
density gain `N^(L - f L)` by a fixed power `g₀`, up to subpower factors. -/
def SlopeDominated (N : ℕ → ℝ) (L : ℝ) (W : ℕ → ℕ)
    (ν : (k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ)))
    (B : (k : ℕ) → Fin (W k) → ℝ) (f : ℝ → ℝ) : Prop :=
  (∀ k γ, B k γ = 1) ∧ ∃ (Λ : ℕ → ℝ) (g₀ : ℝ), 0 < g₀ ∧
    (∀ k γ (Z : Set (EuclideanSpace ℝ (Fin 3))),
      ν k γ {l | (WithLp.toLp 2 ![l.2 3, l.2 4, l.2 5] : EuclideanSpace ℝ (Fin 3)) ∈ Z} ≤
        ENNReal.ofReal (Λ k) * MeasureTheory.volume Z) ∧
    ∀ ε : ℝ, 0 < ε → ∀ᶠ k in Filter.atTop, Λ k ≤ N k ^ (L - f L - g₀ + ε)

/-- What the construction produces from a failure of DK4. -/
def ConstructionOutput : Prop :=
  ∃ (N K : ℕ → ℝ) (L d S η : ℝ) (W : ℕ → ℕ) (ω : (k : ℕ) → Fin (W k) → ℝ)
    (ν : (k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ)))
    (E : (k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ))
    (P : (k : ℕ) → Fin (W k) → MvPolynomial (Fin 4) ℝ) (B : (k : ℕ) → Fin (W k) → ℝ) (f : ℝ → ℝ)
    (g : (k : ℕ) → Fin (W k) → ℝ → (EuclideanSpace ℝ (Fin 3) × ℤ) → ENNReal)
    (G : (k : ℕ) → Fin (W k) → ℝ → ((EuclideanSpace ℝ (Fin 3) × ℤ) × (Fin 2 → ℤ)) → ENNReal),
    TCAHyp N K L d S η W ω ν E P B f g G ∧ SlopeDominated N L W ν B f

/-- What the comparison proves. -/
def ComparisonStatement : Prop :=
  ∀ (N K : ℕ → ℝ) (L d S η : ℝ) (W : ℕ → ℕ) (ω : (k : ℕ) → Fin (W k) → ℝ)
    (ν : (k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ)))
    (E : (k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ))
    (P : (k : ℕ) → Fin (W k) → MvPolynomial (Fin 4) ℝ) (B : (k : ℕ) → Fin (W k) → ℝ) (f : ℝ → ℝ)
    (g : (k : ℕ) → Fin (W k) → ℝ → (EuclideanSpace ℝ (Fin 3) × ℤ) → ENNReal)
    (G : (k : ℕ) → Fin (W k) → ℝ → ((EuclideanSpace ℝ (Fin 3) × ℤ) × (Fin 2 → ℤ)) → ENNReal),
    TCAHyp N K L d S η W ω ν E P B f g G → SlopeDominated N L W ν B f →
      ∃ h : ℝ, 0 < h ∧ ¬ TCAConcl N K L W ω ν E B f h

/-- The assembly: the construction and the comparison give DK4. -/
theorem dk4_of_construction_comparison (H3 : TerminalChartAssertion)
    (hcons : ¬ DK4 → ConstructionOutput) (hcomp : ComparisonStatement) : DK4 := by
  by_contra hbad
  obtain ⟨N, K, L, d, S, η, W, ω, ν, E, P, B, f, g, G, hyp, hdom⟩ := hcons hbad
  obtain ⟨h, hh, hno⟩ := hcomp N K L d S η W ω ν E P B f g G hyp hdom
  exact hno (tca_apply H3 hyp h hh)

/-- The frozen type is `PlankEstimate → SlopeVolumeEstimate → TerminalChartAssertion → DK4`. -/
