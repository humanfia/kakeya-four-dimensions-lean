/-- The conclusion: the discrete four-dimensional Kakeya estimate DK4. -/
def DK4 : Prop :=
  ∀ σ : ℝ, 0 < σ → σ ≤ 1 → ∀ c : ℝ, 0 < c → ∀ R : ℝ, 1 ≤ R → ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → ∀ (n : ℕ) (x v : Fin n → EuclideanSpace ℝ (Fin 4)), c * (2 : ℝ) ^ (3 * k) / ((k : ℝ) + 1) ^ 2 ≤ (n : ℝ) → (∀ i : Fin n, x i 0 = 0 ∧ v i 0 = 1 ∧ ‖v i‖ ≤ 2) → (∀ i j : Fin n, i ≠ j → (2 : ℝ) ^ (-(k : ℤ)) ≤ ‖v i - v j‖) → (∀ i : Fin n, ‖x i‖ ≤ R) → ∀ (m : ℕ) (z : Fin m → EuclideanSpace ℝ (Fin 4)) (ρ : Fin m → ℝ), (m : ℝ) ≤ (2 : ℝ) ^ (((k : ℝ) + 1) * (4 - σ)) → (∀ j : Fin m, (2 : ℝ) ^ (-((k : ℤ) + 1)) < ρ j ∧ ρ j ≤ (2 : ℝ) ^ (-(k : ℤ))) → ¬ (∀ i : Fin n, ENNReal.ofReal (c / ((k : ℝ) + 1) ^ 2) ≤ MeasureTheory.volume {t : ℝ | t ∈ Set.Icc (0 : ℝ) 1 ∧ x i + t • v i ∈ ⋃ j : Fin m, Metric.ball (z j) (ρ j)})

/-- The antecedents of the terminal-chart assertion for given data. -/
structure TCAHyp (N K : ℕ → ℝ) (L d S η : ℝ) (W : ℕ → ℕ) (ω : (k : ℕ) → Fin (W k) → ℝ) (ν : (k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ))) (E : (k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) (P : (k : ℕ) → Fin (W k) → MvPolynomial (Fin 4) ℝ) (B : (k : ℕ) → Fin (W k) → ℝ) (f : ℝ → ℝ) (g : (k : ℕ) → Fin (W k) → ℝ → (EuclideanSpace ℝ (Fin 3) × ℤ) → ENNReal) (G : (k : ℕ) → Fin (W k) → ℝ → ((EuclideanSpace ℝ (Fin 3) × ℤ) × (Fin 2 → ℤ)) → ENNReal) : Prop where
  two_le_N : ∀ k, 2 ≤ N k
  tendsto_N : Filter.Tendsto N Filter.atTop Filter.atTop
  subpower_K : (∀ k, 1 ≤ K k) ∧ ∀ ε : ℝ, 0 < ε → ∀ᶠ k in Filter.atTop, K k ≤ N k ^ ε
  L_pos : 0 < L
  d_pos : 0 < d
  d_lt_one : d < 1
  S_pos : 0 < S
