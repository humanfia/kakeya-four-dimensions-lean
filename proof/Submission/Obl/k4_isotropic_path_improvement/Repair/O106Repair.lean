import Mathlib
import ChallengeDeps

set_option linter.unusedVariables false

/-!
# A repaired split of o106 (`k4_isotropic_path_improvement`), checked at the type level

Not part of o064's proof. Session x0678 (o064) wrote this to support a re-split of o106.

The frozen children of o106's split s041 couple the width exit of o116 with the candidate
gain: o116's width disjunct narrows by `gain` while its candidates may lose `N^(ρ·gain·L)`.
A strip concentration at scale `N^(-u L)` only narrows by about `u/4`, and Thm 6.1's losses
with breadth at scale `u` are `N^(C u L)`, so the paper's route cannot meet o116 for small `ρ`.

Repair: `frozen116` (o116 with the width exit at a separate `gainW ≤ θ·gain`, and the grid,
first node and `δ₀` bounded by `θ·gain` for a caller-chosen `θ > 0`) and `frozen117` (o117
with the width disjunct at `gainW ≤ α·gain` passed through to a width exit at `gainW`, and
depth exits as before). `glue_frozen` derives o106's exact frozen statement from them: depth
exits of gain `α·gain` are re-indexed to a later path node (`later_node`), so X holds with
`Δ = gainW`.

The predicates `mk … improvement` are copied from o106's split s041 (session x0368, o106
repository, branch `x0368`, `Submission/Obl/k4_isotropic_path_improvement/Interfaces.lean`);
`discovery2`, `improvement2`, `O116'`, `O117'`, `later_node`, `glue` are new.
-/

noncomputable section

namespace Submission.Obl.k4_isotropic_path_improvement.Repair.O106Repair

/-- Later-node re-indexing of a depth exit (pure arithmetic). -/
theorem later_node {N L κ₁ Δd Δ δ₀ sp b r₂ : ℝ} {m : ℕ} {s r : ℕ → ℝ} {T : ℕ → ℕ} {T₂ : ℕ}
    (hN : 1 ≤ N) (hL : 0 < L) (hκ : 0 < κ₁) (hΔ : 0 ≤ Δ) (hδ₀ : 0 ≤ δ₀) (hsp0 : 0 ≤ sp)
    (hend : s (m - 1) = 1)
    (hsp : ∀ i, i + 1 < m → s (i + 1) - s i ≤ sp)
    (hpar : Δ + 2 * δ₀ + sp + 2 * δ₀ / κ₁ ≤ Δd / 2)
    (hnodes : ∀ i, i < m → |r i - s i * L| ≤ δ₀ * L ∧ N ^ ((κ₁ * s i - δ₀) * L) ≤ (2 : ℝ) ^ T i)
    (hbase : ∃ j, j < m ∧ s j ≤ b + Δd - Δ - 2 * δ₀)
    (hglob : r₂ + Δ * L ≤ L)
    (hdepth : (b - δ₀ + Δd) * L ≤ r₂)
    (htime : (2 : ℝ) ^ T₂ ≤ N ^ ((κ₁ * b + δ₀ + κ₁ * Δd / 2) * L)) :
    ∃ i, i < m ∧ r i + Δ * L ≤ r₂ ∧ (2 : ℝ) ^ T₂ ≤ (2 : ℝ) ^ T i * N ^ (κ₁ * Δ * L / 2) := by
  classical
  obtain ⟨j₀, hj₀m, hj₀⟩ := hbase
  set P : ℕ → Prop := fun j => s j ≤ b + Δd - Δ - 2 * δ₀ with hP
  set i' := Nat.findGreatest P (m - 1) with hi'
  have hi'le : i' ≤ m - 1 := Nat.findGreatest_le _
  have hi'm : i' < m := by omega
  have hPi' : P i' := Nat.findGreatest_spec (P := P) (m := j₀) (by omega) hj₀
  have hlow : b + Δd / 2 + 2 * δ₀ / κ₁ ≤ s i' := by
    by_cases hlast : i' + 1 < m
    · have hnot : ¬ P (i' + 1) := Nat.findGreatest_is_greatest (n := m - 1) (by omega) (by omega)
      simp only [hP, not_le] at hnot
      have := hsp i' hlast
      linarith
    · have hi'eq : i' = m - 1 := by omega
      rw [hi'eq, hend]
      have h1 : (b - δ₀ + Δd) * L ≤ (1 - Δ) * L := by nlinarith
      have h2 : b - δ₀ + Δd ≤ 1 - Δ := le_of_mul_le_mul_right h1 hL
      have h3 : 0 ≤ 2 * δ₀ / κ₁ := by positivity
      linarith
  obtain ⟨hri', hTi'⟩ := hnodes i' hi'm
  refine ⟨i', hi'm, ?_, ?_⟩
  · have h1 := (abs_le.mp hri').2
    simp only [hP] at hPi'
    have h2 : (s i' + Δ) * L ≤ (b + Δd - δ₀ - δ₀) * L := by
      apply mul_le_mul_of_nonneg_right _ hL.le; linarith
    nlinarith
  · calc (2 : ℝ) ^ T₂ ≤ N ^ ((κ₁ * b + δ₀ + κ₁ * Δd / 2) * L) := htime
      _ ≤ N ^ ((κ₁ * s i' - δ₀) * L + κ₁ * Δ * L / 2) := by
          apply Real.rpow_le_rpow_of_exponent_le hN
          have h1 : κ₁ * (b + Δd / 2 + 2 * δ₀ / κ₁) ≤ κ₁ * s i' :=
            mul_le_mul_of_nonneg_left hlow hκ.le
          have e : κ₁ * (2 * δ₀ / κ₁) = 2 * δ₀ := by field_simp
          have h2 : κ₁ * b + δ₀ + κ₁ * Δd / 2 ≤ κ₁ * s i' - δ₀ + κ₁ * Δ / 2 := by
            have : 0 ≤ κ₁ * Δ := mul_nonneg hκ.le hΔ
            nlinarith
          have h3 := mul_le_mul_of_nonneg_right h2 hL.le
          linarith
      _ = N ^ ((κ₁ * s i' - δ₀) * L) * N ^ (κ₁ * Δ * L / 2) := by
          rw [Real.rpow_add (by linarith)]
      _ ≤ (2 : ℝ) ^ T i' * N ^ (κ₁ * Δ * L / 2) := by
          apply mul_le_mul_of_nonneg_right hTi' (by positivity)


