/-- The polynomial-cost continuation input in the frozen statement. -/
abbrev Continuation : Prop := (∀ n m D s : ℕ, ∃ q : ℕ, ∃ C : ℝ, s ≤ q ∧ 0 < C ∧ ∀ A : ℝ, 2 ≤ A → ∀ a b c : EuclideanSpace ℂ (Fin n), ‖a‖ ≤ 1 → ‖b‖ ≤ 1 → ‖c‖ ≤ 1 → ∀ (P : Fin m → MvPolynomial (Fin (n + 1)) ℂ) (f : Fin m → EuclideanSpace ℂ (Fin n) → ℂ) (Q : MvPolynomial (Fin (n + m)) ℂ), (fun U : Set (EuclideanSpace ℂ (Fin n)) => (fun H : EuclideanSpace ℂ (Fin n) → ℂ => (∀ i, P i ≠ 0 ∧ (P i).totalDegree ≤ 2 ∧ DifferentiableOn ℂ (f i) U ∧ ∀ z ∈ U, MvPolynomial.eval (Fin.snoc (fun j : Fin n => z j) (f i z)) (P i) = 0 ∧ MvPolynomial.eval (Fin.snoc (fun j : Fin n => z j) (f i z)) (MvPolynomial.pderiv (Fin.last n) (P i)) ≠ 0) → Q.totalDegree ≤ D → ∀ V : ℝ, 0 ≤ V → ((∀ z ∈ Metric.closedBall a ((8 * A)⁻¹), ‖H z‖ ≤ V) → (∀ z ∈ Metric.closedBall c ((8 * A)⁻¹), ‖H z‖ ≤ A ^ C * V) ∧ ∀ j : ℕ, j ≤ q → ‖iteratedFDeriv ℂ j H c‖ ≤ A ^ C * V) ∧ ((∀ j : ℕ, j ≤ q → ‖iteratedFDeriv ℂ j H c‖ ≤ V) → ∀ z ∈ Metric.closedBall a ((8 * A)⁻¹), ‖H z‖ ≤ A ^ C * V)) (fun z => MvPolynomial.eval (Fin.append (fun j : Fin n => z j) (fun i : Fin m => f i z)) Q)) (Metric.thickening (A⁻¹) (segment ℝ a b ∪ segment ℝ b c)))

/-- The quantitative discriminant safe-path input in the frozen statement. -/
abbrev SafePaths : Prop := (((fun emb : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℂ (Fin 3) => ∃ C : ℕ, 0 < C ∧ ∀ A : ℝ, 2 ≤ A → ∀ P P' : MvPolynomial (Fin 3) ℝ, P.totalDegree ≤ 2 → P'.totalDegree ≤ 2 → (∀ d, |P.coeff d| ≤ A) → (∀ d, |P'.coeff d| ≤ A) → ∀ z₀ : EuclideanSpace ℝ (Fin 3), ‖z₀‖ ≤ (1 : ℝ) / 8 → A⁻¹ ≤ |MvPolynomial.eval (fun i => z₀ i) P| → A⁻¹ ≤ |MvPolynomial.eval (fun i => z₀ i) P'| → (fun bad : Set (EuclideanSpace ℝ (Fin 3) × ℂ) => MeasurableSet bad ∧ (MeasureTheory.volume.prod MeasureTheory.volume) bad ≤ ENNReal.ofReal A⁻¹ * (MeasureTheory.volume.prod MeasureTheory.volume) ((Metric.closedBall (0 : EuclideanSpace ℝ (Fin 3)) ((1 : ℝ) / 8)) ×ˢ (Metric.closedBall (1 / 2 : ℂ) ((1 : ℝ) / 4)))) {p | p.1 ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin 3)) ((1 : ℝ) / 8) ∧ p.2 ∈ Metric.closedBall (1 / 2 : ℂ) ((1 : ℝ) / 4) ∧ ∃ z ∈ Metric.thickening (A ^ (-(C : ℝ))) (segment ℝ (emb z₀) (emb z₀ + p.2 • (emb p.1 - emb z₀)) ∪ segment ℝ (emb z₀ + p.2 • (emb p.1 - emb z₀)) (emb p.1)), ‖MvPolynomial.eval (fun i => z i) (P.map (algebraMap ℝ ℂ))‖ < A ^ (-(C : ℝ)) ∨ ‖MvPolynomial.eval (fun i => z i) (P'.map (algebraMap ℝ ℂ))‖ < A ^ (-(C : ℝ))}) (fun z => WithLp.toLp 2 (fun i => (z i : ℂ)))))

noncomputable def emb : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℂ (Fin 3) :=
  fun z => WithLp.toLp 2 (fun i => (z i : ℂ))

noncomputable def base : ℕ → ℝ → ℝ → EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) → Matrix (Fin 2) (Fin 2) ℝ → (ℕ × (Fin 6 → ℝ)) → ℝ → EuclideanSpace ℝ (Fin 3) :=
  fun T j κ c u Q l t => WithLp.toLp 2 ![(((2 : ℝ) ^ T) * t - j - 1 / 2) / (100 * κ), (Matrix.toEuclideanLin Q⁻¹ (y l t - c - t • u)) 0 / (100 * κ), (Matrix.toEuclideanLin Q⁻¹ (y l t - c - t • u)) 1 / (100 * κ)]

noncomputable def disc : MvPolynomial (Fin 4) ℝ → MvPolynomial (Fin 3) ℝ :=
  fun P => MvPolynomial.eval₂Hom MvPolynomial.C (Fin.lastCases (0 : MvPolynomial (Fin 3) ℝ) MvPolynomial.X) ((MvPolynomial.pderiv (3 : Fin 4) P) ^ 2 - 2 * MvPolynomial.pderiv (3 : Fin 4) (MvPolynomial.pderiv (3 : Fin 4) P) * P)

noncomputable def localPair : ℝ → ℝ → ℝ → ℝ → MvPolynomial (Fin 4) ℝ → MvPolynomial (Fin 4) ℝ → EuclideanSpace ℝ (Fin 3) → (ℝ → EuclideanSpace ℝ (Fin 3)) → (ℝ → ℝ) → ℝ → Set ℝ → Prop :=
  fun Nk a δv q P P' z zline wline t₀ I => Nk ^ (-a) ≤ |MvPolynomial.eval (fun i => z i) (disc P)| ∧ Nk ^ (-a) ≤ |MvPolynomial.eval (fun i => z i) (disc P')| ∧ ∃ f f' : EuclideanSpace ℂ (Fin 3) → ℂ, (∀ (R : MvPolynomial (Fin 4) ℝ) (F : EuclideanSpace ℂ (Fin 3) → ℂ), (R = P ∧ F = f) ∨ (R = P' ∧ F = f') → DifferentiableOn ℂ F (Metric.ball (emb z) (8 * Nk ^ (-a))) ∧ (∀ ζ ∈ Metric.ball (emb z) (8 * Nk ^ (-a)), MvPolynomial.eval (Fin.snoc (fun i : Fin 3 => ζ i) (F ζ)) (R.map (algebraMap ℝ ℂ)) = 0 ∧ MvPolynomial.eval (Fin.snoc (fun i : Fin 3 => ζ i) (F ζ)) ((MvPolynomial.pderiv (3 : Fin 4) R).map (algebraMap ℝ ℂ)) ≠ 0) ∧ ∀ z' ∈ Metric.ball z (8 * Nk ^ (-a)), (F (emb z')).im = 0) ∧ ‖f (emb z) - (wline t₀ : ℂ)‖ ≤ δv * Nk ^ a ∧ ‖f' (emb z) - (wline t₀ : ℂ)‖ ≤ δv * Nk ^ a ∧ (∀ z' ∈ Metric.closedBall z (2 * Nk ^ (-a)), ‖f (emb z') - f' (emb z')‖ ≤ δv * Nk ^ a) ∧ ∀ t ∈ I ∩ Set.Icc (t₀ - Nk ^ (-a) / (100 * q)) (t₀ + Nk ^ (-a) / (100 * q)), ‖(wline t : ℂ) - f (emb (zline t))‖ ≤ δv * Nk ^ a

noncomputable def paired : (ℕ → ℝ) → (W : ℕ → ℕ) → ((k : ℕ) → Fin (W k) → ℝ) → ((k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ))) → ((k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) → ((k : ℕ) → Fin (W k) → ℝ) → ℝ → ℝ → ℝ → Prop :=
