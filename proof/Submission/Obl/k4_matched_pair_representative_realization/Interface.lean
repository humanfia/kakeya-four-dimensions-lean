e s)) (Q (frame s)) p.1 t‖ ≤ (1 : ℝ) / 8 ∧ ∀ t' ∈ Set.Icc (((j (frame s) : ℕ) : ℝ) / (2 : ℝ) ^ T) ((((j (frame s) : ℕ) : ℝ) + 1) / (2 : ℝ) ^ T), ‖base T ((j (frame s) : ℕ) : ℝ) κ (c (frame s)) (u (frame s)) (Q (frame s)) p.1 t - base T ((j (frame s) : ℕ) : ℝ) κ (c (frame s)) (u (frame s)) (Q (frame s)) p.1 t'‖ ≤ (2 : ℝ) ^ T * |t - t'|) ∧ (∀ s s', s ≠ s' → γ (frame s) = γ (frame s') → j (frame s) = j (frame s') → Disjoint (S s) (S s')) ∧ (∀ γ₀ o, ((lst γ₀ o).card : ℝ) ≤ κ) ∧ (∀ γ₀ s, MeasurableSet {p | s ∈ lst γ₀ (obs (B k γ₀) (δ (N k) L) p)} ∧ ∀ i, fmt 7 (N k ^ M) D {r : Fin 7 → ℝ | s ∈ lst γ₀ (obs (B k γ₀) (δ (N k) L) ((i, fun z : Fin 6 => r z.castSucc), r 6))}) ∧ (∀ s, MeasurableSet (H s) ∧ ∀ p ∈ H s, (p.1, p.2.1) ∈ S s ∧ p.2.2 ∈ Set.Icc (((j (frame s) : ℕ) : ℝ) / (2 : ℝ) ^ T) ((((j (frame s) : ℕ) : ℝ) + 1) / (2 : ℝ) ^ T) ∧ (p.1, p.2.2) ∈ E k (γ (frame s)) ∧ ∃ s' ∈ lst (γ (frame s)) (obs (B k (γ (frame s))) (δ (N k) L) (p.1, p.2.2)), frame s' = frame s ∧ localPair (N k) a (δ (N k) L) ((2 : ℝ) ^ T) (P s) (P s') (base T ((j (frame s) : ℕ) : ℝ) κ (c (frame s)) (u (frame s)) (Q (frame s)) p.1 p.2.1) (base T ((j (frame s) : ℕ) : ℝ) κ (c (frame s)) (u (frame s)) (Q (frame s)) p.1) (fun t => B k (γ (frame s)) * (x p.1 t) 3) p.2.1 (Set.Icc (((j (frame s) : ℕ) : ℝ) / (2 : ℝ) ^ T) ((((j (frame s) : ℕ) : ℝ) + 1) / (2 : ℝ) ^ T))) ∧ (∀ s, 0 ≤ β s ∧ ∀ U : Set (EuclideanSpace ℝ (Fin 3)), MeasurableSet U → ENNReal.ofReal ((2 : ℝ) ^ T) ^ 2 * ((ν k (γ (frame s))).prod (MeasureTheory.volume.prod MeasureTheory.volume)) (H s ∩ {p | base T ((j (frame s) : ℕ) : ℝ) κ (c (frame s)) (u (frame s)) (Q (frame s)) p.1 p.2.1 ∈ U}) ≤ ENNReal.ofReal (β s) * MeasureTheory.volume U) ∧ (∑ s, ω k (γ (frame s)) * β s / (2 : ℝ) ^ T) ≤ N k ^ a ∧ ENNReal.ofReal κ⁻¹ ≤ ∑ s, ENNReal.ofReal (ω k (γ (frame s)) * (2 : ℝ) ^ T) * ((ν k (γ (frame s))).prod (MeasureTheory.volume.prod MeasureTheory.volume)) (H s)

/-- The realization conclusion, using the accepted rough-atlas model. -/
abbrev Realization : Prop :=
  ∃ C₂ c₂ : ℝ, 0 < C₂ ∧ 0 < c₂ ∧ ∀ (N : ℕ → ℝ) (W : ℕ → ℕ) (ω : (k : ℕ) → Fin (W k) → ℝ) (ν : (k : ℕ) → Fin (W k) → MeasureTheory.Measure (ℕ × (Fin 6 → ℝ))) (E : (k : ℕ) → Fin (W k) → Set ((ℕ × (Fin 6 → ℝ)) × ℝ)) (B : (k : ℕ) → Fin (W k) → ℝ) (L a h : ℝ), 0 < a → a < c₂ * L → paired N W ω ν E B L a h → roughSys N W ω ν E B L (C₂ * a) h

end Submission.Obl.k4_matched_pair_representative_realization
